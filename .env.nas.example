# Copy to .env next to docker-compose.nas.yml. Never commit the real file.

# Database password for the bundled Postgres (any long random string).
POSTGRES_PASSWORD=

# 32+ random characters. Encrypts the PII vault; keep it stable, or stored personal data becomes unreadable.
PII_KEY=

# Claude key for live answers. Leave empty to run the deterministic offline planner.
ANTHROPIC_API_KEY=

# Password for /console (any username).
CONSOLE_PASSWORD=

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install command).
CLOUDFLARE_TUNNEL_TOKEN=

# Port on the NAS for LAN access, e.g. http://<nas-ip>:3080
WEB_PORT=3080
