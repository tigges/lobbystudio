# Postgres 16 with pgvector. `pnpm dev` starts one with Docker if nothing is listening here.
DATABASE_URL=postgres://dental:dental@localhost:5432/dental_bot

# Chat model (planner + grounded phrasing). Either name works.
# Without a key the runtime uses the deterministic offline planner so the demo still runs.
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=

# live | offline. Defaults to live when an Anthropic key is present.
# LLM_MODE=

# 32+ character secret used to encrypt the PII vault. Required in production.
PII_KEY=dev-only-pii-key-change-me-0123456789

# Optional basic-auth password for /console.
# CONSOLE_PASSWORD=
